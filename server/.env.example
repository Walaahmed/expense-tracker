# انسخي الملف ده باسم .env وعدّلي القيم
PORT=4000

# مفتاح سري لتوقيع الـ JWT. لازم يبقى طويل وعشوائي في الإنتاج.
# لتوليد واحد:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# عنوان الواجهة المسموح لها تكلم الـ API (CORS). ممكن أكتر من واحد مفصولين بفاصلة.
CLIENT_URL=http://localhost:5173

# قاعدة البيانات:
#  - سيبي DATABASE_URL فاضي في التطوير: هيستخدم SQLite (ملف DB_FILE) من غير أي تثبيت.
#  - في النشر (Vercel) لازم PostgreSQL. حطي الرابط اللي بياخده من Neon، آخره sslmode=require
#    مثال: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_FILE=data.db
